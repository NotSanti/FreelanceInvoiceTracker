# Public Supabase values. Copy to .env.local and fill in from the project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional alias used by some templates. The app also accepts this if the publishable key is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose these to the browser.
RESEND_API_KEY=
# Mailbox used in From. Display name is always the user's business name:
#   Acme Studio <invoices@independentpocket.com>
EMAIL_FROM=invoices@independentpocket.com
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (PWA). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional mailto: or https: contact for VAPID. Defaults to EMAIL_FROM when set.
# VAPID_SUBJECT=mailto:you@example.com

# Stripe webhook endpoint: POST {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
# Checkout uses the service role to load remaining balance without exposing internal IDs to the public API.
