# Public Supabase values. Copy to .env.local and fill in from the project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional alias used by some templates. The app also accepts this if the publishable key is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose these to the browser.
RESEND_API_KEY=
# Mailbox used in From. Display name is always the user's business name:
#   Acme Studio <invoices@independentpocket.com>
EMAIL_FROM=invoices@independentpocket.com
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_TOKEN_ENCRYPTION_KEY=

# Stripe (existing merchant Checkout plus upcoming Connect)
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Square application (OAuth + Payment Links)
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match the Square webhook subscription URL exactly when set.
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://independentpocket.com/api/payments/webhooks/square

# PayPal platform (Sandbox until partner approval)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_ATTRIBUTION_ID=
# Sandbox/live partner merchant ID from PayPal account settings (Business information).
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=

# Feature flags
PAYMENTS_STRIPE_ENABLED=true
PAYMENTS_SQUARE_ENABLED=true
PAYMENTS_PAYPAL_ENABLED=false

# Multi-user SaaS: signup is allowed by default. Set false to lock registration,
# and disable "Allow new users" in the Supabase Auth dashboard to match.
# NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false

# Web Push (PWA). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional mailto: or https: contact for VAPID. Defaults to EMAIL_FROM when set.
# VAPID_SUBJECT=mailto:you@example.com

# Stripe webhook endpoint: POST {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
# Checkout uses the service role to load remaining balance without exposing internal IDs to the public API.
